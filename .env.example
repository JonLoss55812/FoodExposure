# All of these are optional — the app runs offline with no .env at all.
# Every line is commented out so that copying this file to .env changes nothing.
# Uncomment only the ones you have a real value for: a placeholder value is
# not "unset" — e.g. a placeholder PostHog key would initialise PostHog.

# Convex backend. Scaffolded in convex/ but not yet called by any app code;
# ConvexProvider falls back to a placeholder URL when this is unset.
# EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Sentry. Init is skipped entirely when unset (src/lib/sentry.ts).
# EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# PostHog. Init is skipped entirely when the key is unset (src/lib/posthog.ts).
# Host defaults to https://us.i.posthog.com.
# EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-key
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
